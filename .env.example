# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GAPGPT_API_KEY: Optional custom OpenAI / GapGPT API Key.
GAPGPT_API_KEY=""

# GAPGPT_BASE_URL: Base proxy URL for OpenAI compat. API. Defaults to https://api.gapgpt.app/v1
GAPGPT_BASE_URL="https://api.gapgpt.app/v1"

# GAPGPT_MODEL: The default model to query. Defaults to gpt-4o-mini.
GAPGPT_MODEL="gpt-4o-mini"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

